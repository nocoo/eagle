#!/bin/sh
# Fast gate on the staged snapshot: Biome for web/worker/contracts, the Bots
# project's own Biome for apps/bots, swift-format for the macOS and bots-macos
# packages. Keep it well under 30 seconds.
set -eu
cd "$(git rev-parse --show-toplevel)"

if ! git diff --cached --quiet -- apps/macos tests/native/design-guard.test.ts \
  tests/native/design-gate.test.ts .githooks/pre-commit .github/workflows/check.yml package.json; then
  echo "pre-commit: staged design ownership"
  (
    snapshot=$(mktemp -d "${TMPDIR:-/tmp}/eagle-design-index.XXXXXX")
    trap 'rm -rf "$snapshot"' EXIT
    git checkout-index --all --prefix="$snapshot/"
    for path in apps apps/macos apps/macos/Sources apps/macos/Scripts tests tests/native; do
      if [ -L "$snapshot/$path" ] || [ ! -d "$snapshot/$path" ]; then
        echo "design-guard: snapshot path refused: $path" >&2
        exit 1
      fi
    done
    for path in apps/macos/Scripts/check-design.ts apps/macos/Scripts/DesignGuard.swift \
      tests/native/design-guard.test.ts; do
      if [ -L "$snapshot/$path" ] || [ ! -f "$snapshot/$path" ]; then
        echo "design-guard: snapshot path refused: $path" >&2
        exit 1
      fi
    done
    node "$snapshot/apps/macos/Scripts/check-design.ts"
    node --test "$snapshot/tests/native/design-guard.test.ts"
  )
fi

staged=$(git diff --cached --name-only --diff-filter=ACM)
[ -n "$staged" ] || exit 0

code=$(printf '%s\n' "$staged" | grep -E '\.(ts|tsx|js|mjs|cjs|json|css|html)$' | grep -v '^apps/bots/' || true)
if [ -n "$code" ]; then
  echo "pre-commit: biome"
  # shellcheck disable=SC2086
  npx --no-install biome check --error-on-warnings $code
fi

bots=$(printf '%s\n' "$staged" | grep -E '^apps/bots/.*\.(ts|json)$' || true)
if [ -n "$bots" ]; then
  echo "pre-commit: bots lint"
  if [ -d apps/bots/node_modules ]; then
    # shellcheck disable=SC2046
    (cd apps/bots && npx --no-install biome check --error-on-warnings \
      $(printf '%s\n' "$bots" | sed 's|^apps/bots/||'))
  else
    echo "pre-commit: apps/bots dependencies missing, skipping bots lint" >&2
  fi
fi

if printf '%s\n' "$staged" | grep -qE '^apps/(macos|bots-macos)/.*\.swift$'; then
  echo "pre-commit: swift format"
  if [ -d /Applications/Xcode.app/Contents/Developer ]; then
    export DEVELOPER_DIR="${DEVELOPER_DIR:-/Applications/Xcode.app/Contents/Developer}"
  fi
  if command -v swift >/dev/null 2>&1; then
    if printf '%s\n' "$staged" | grep -q '^apps/macos/.*\.swift$'; then
      (cd apps/macos && swift format lint --strict --recursive Sources Scripts Tests)
    fi
    if printf '%s\n' "$staged" | grep -q '^apps/bots-macos/.*\.swift$'; then
      (cd apps/bots-macos && swift format lint --strict --recursive Sources Tests)
    fi
  else
    echo "pre-commit: swift not installed, skipping Swift lint" >&2
  fi
fi
