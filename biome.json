{
  "$schema": "https://biomejs.dev/schemas/2.6.4/schema.json",
  "files": {
    "includes": [
      "**",
      "!**/worker-configuration.d.ts",
      "!apps/bots",
      "!apps/bots-sync",
      "!**/dist",
      "!**/.build",
      "!node_modules",
      "!package-lock.json",
      "!**/*.md",
      "!**/.wrangler",
      "!test-results",
      "!playwright-report",
      "!.local",
      "!**/.local"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space"
  },
  "linter": {
    "enabled": true,
    "rules": {
      "correctness": {
        "noInvalidPositionAtImportRule": "off",
        "noInvalidGridAreas": "off"
      }
    }
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double"
    }
  },
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  }
}
