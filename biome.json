{
  "$schema": "https://biomejs.dev/schemas/2.5.15/schema.json",
  "files": {
    "includes": [
      "**",
      "!worker-configuration.d.ts",
      "!dist",
      "!agent/dist",
      "!node_modules",
      "!package-lock.json",
      "!.wrangler",
      "!test-results",
      "!playwright-report",
      "!.local"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space"
  },
  "linter": {
    "enabled": true,
    "rules": {
      "correctness": {
        "noInvalidPositionAtImportRule": "off"
      }
    }
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double"
    }
  },
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  }
}
