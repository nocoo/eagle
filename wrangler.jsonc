{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "eagle",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-09-19",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "triggers": { "crons": ["59 15 * * *"] },
  "durable_objects": {
    "bindings": [
      { "name": "MACHINES", "class_name": "MachineState" },
      { "name": "DIRECTORY", "class_name": "MachineDirectory" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["MachineState"] },
    { "tag": "v2", "new_sqlite_classes": ["MachineDirectory"] }
  ],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true
  },
  "routes": [
    {
      "pattern": "eagle.hexly.ai",
      "custom_domain": true
    },
    {
      "pattern": "eagle-ingest.hexly.ai",
      "custom_domain": true
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "eagle",
      "database_id": "23d72296-f25a-4a65-9187-4994f42ca39a",
      "migrations_dir": "migrations"
    }
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "dev": {
    "ip": "127.0.0.1",
    "host": "eagle.dev.hexly.ai",
    "port": 37053,
    "inspector_port": 38053
  },
  "vars": {
    "BUILD_REVISION": "development",
    "LOCAL_DEV": "false",
    "ACCESS_TEAM_URL": "https://nocoo.cloudflareaccess.com",
    "ACCESS_AUD": "d1ffdb7fe2787e2a9e8f957a68ed5feec2b944c44c6fdbfd54341887eab6f873"
  }
}
