{
  "name": "eagle",
  "version": "0.14.2",
  "config": {
    "publishedAgentVersion": "1.0.0",
    "publishedMacosVersion": "0.16.0",
    "macosReleaseUrl": "https://github.com/nocoo/eagle/releases/latest",
    "repositoryUrl": "https://github.com/nocoo/eagle"
  },
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/web",
    "packages/contracts",
    "packages/agent"
  ],
  "scripts": {
    "dev": "npm --workspace @eagle/web run dev",
    "dev:api": "npm --workspace @eagle/web run dev:api",
    "build": "npm --workspace @eagle/web run build",
    "typecheck": "tsc --noEmit",
    "lint": "biome check . --error-on-warnings",
    "format": "biome check --write .",
    "test": "node --test tests/*.test.ts",
    "test:devices": "node --test tests/device-integration/*.test.ts",
    "test:browser": "playwright test",
    "test:focus": "node --test tests/native/composer-focus.test.ts",
    "check": "npm run test && npm run typecheck && npm run lint && npm run build",
    "deploy": "node scripts/deploy.ts",
    "agent": "node packages/agent/cli.ts",
    "db:local": "wrangler d1 migrations apply eagle --local --config apps/web/wrangler.jsonc",
    "db:remote": "wrangler d1 migrations apply eagle --remote --config apps/web/wrangler.jsonc",
    "prepare": "sh scripts/install-hooks.sh",
    "verify": "npm run check && npm run test:browser"
  },
  "overrides": {
    "undici": "^7.30.1",
    "sharp": "0.35.5",
    "source-map-js": "1.2.2"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.4",
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.5",
    "miniflare": "5.20260918.0-alpha",
    "typescript": "7.0.2",
    "ws": "8.22.0",
    "zod": "^4.6.7"
  }
}
