{
  "name": "eagle",
  "version": "0.10.1",
  "config": {
    "publishedAgentVersion": "0.8.1"
  },
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 7053 --strictPort",
    "dev:api": "wrangler dev --port 37053 --inspector-port 38053",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "lint": "biome check . --error-on-warnings",
    "format": "biome check --write .",
    "test": "node --test tests/*.test.ts",
    "test:browser": "playwright test",
    "check": "npm run test && npm run typecheck && npm run lint && npm run build",
    "deploy": "node scripts/deploy.ts",
    "agent": "node agent/cli.ts",
    "db:local": "wrangler d1 migrations apply eagle --local",
    "db:remote": "wrangler d1 migrations apply eagle --remote"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "4.0.71",
    "@ai-sdk/openai": "4.0.83",
    "@nocoo/basalt": "2.2.0",
    "@nocoo/next-ai": "^0.4.0",
    "ai": "7.0.126",
    "jose": "^6.2.12",
    "lucide-react": "1.49.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "recharts": "^3.10.1",
    "ws": "8.22.0",
    "zod": "^4.1.0"
  },
  "overrides": {
    "undici": "7.29.1"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^25.0.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@types/ws": "8.18.2",
    "@vitejs/plugin-react": "^6.1.0",
    "miniflare": "5.20260918.0-alpha",
    "tailwindcss": "^4.3.3",
    "typescript": "7.0.2",
    "vite": "8.3.1",
    "wrangler": "4.145.0"
  }
}
