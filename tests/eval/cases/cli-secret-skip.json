{
  "id": "cli-secret-skip",
  "title": "Skip a password card through the CLI",
  "kind": "chat",
  "toolGroups": ["core", "secrets"],
  "model": {
    "script": [
      {
        "toolCall": {
          "name": "secret_request",
          "args": {
            "key": "eval-skipped",
            "purpose": "Optional synthetic fixture",
            "scope": "bot"
          }
        }
      },
      { "text": "The card is ready." },
      { "text": "I will continue without it." }
    ]
  },
  "steps": [
    {
      "kind": "cli",
      "args": [
        "chat",
        "send",
        "eval cli-secret-skip",
        "--text",
        "Request the optional fixture",
        "--wait",
        "--json"
      ],
      "stdoutContains": "secret_request",
      "oneTerminal": true,
      "capture": "reply"
    },
    {
      "kind": "cli",
      "args": [
        "chat",
        "history",
        "eval cli-secret-skip",
        "--before",
        "{{reply.answerEntryId}}",
        "--limit",
        "20",
        "--json"
      ],
      "capture": "card"
    },
    {
      "kind": "cli",
      "args": [
        "chat",
        "secret",
        "eval cli-secret-skip",
        "--entry",
        "{{card.messages.1.id}}",
        "--key",
        "eval-skipped",
        "--skip",
        "--json"
      ],
      "expectExit": 0
    },
    {
      "kind": "waitFor",
      "role": "assistant",
      "contains": "I will continue without it.",
      "count": 1
    }
  ],
  "expect": {
    "toolsCalled": ["secret_request"],
    "messagesExcluded": [{ "role": "tool", "contains": "secret_read" }],
    "modelRequests": { "max": 3 },
    "noErrors": true
  }
}
