{
  "id": "cli-surface",
  "title": "dev CLI 的基础面：版本、skill、health、whoami、usage 与退出码",
  "kind": "chat",
  "notes": "The whole surface one agent needs before it trusts the CLI: the document, the identity it presents, and every documented exit code. Nothing here talks to a model.",
  "timeoutMs": 60000,
  "model": {
    "script": [
      {
        "text": "no model reply is needed"
      }
    ]
  },
  "steps": [
    {
      "kind": "cli",
      "args": ["--version"],
      "stdoutContains": "eagle-dev"
    },
    {
      "kind": "cli",
      "args": ["--version"],
      "stdoutContains": "daemon"
    },
    {
      "kind": "cli",
      "args": ["--skill"],
      "stdoutContains": "bots list"
    },
    {
      "kind": "cli",
      "args": ["health", "--json"],
      "json": {
        "bots": 1
      }
    },
    {
      "kind": "cli",
      "args": ["whoami", "--json"],
      "json": {
        "client": {
          "name": "dev-agent"
        }
      }
    },
    {
      "kind": "cli",
      "args": ["usage", "--json", "--days", "7"],
      "json": {
        "usage": {
          "week": {}
        }
      },
      "jsonLengths": {
        "usage.days": 7
      }
    },
    {
      "kind": "cli",
      "args": ["bots"],
      "expectExit": 2,
      "stderrContains": "bots list"
    },
    {
      "kind": "cli",
      "args": ["bots", "nope"],
      "expectExit": 2,
      "stderrContains": "unknown"
    },
    {
      "kind": "cli",
      "args": ["bots", "delete", "eval cli-surface"],
      "expectExit": 2,
      "stderrContains": "--yes"
    },
    {
      "kind": "cli",
      "args": ["health"],
      "env": {
        "EAGLE_PORT": "1"
      },
      "expectExit": 4
    },
    {
      "kind": "cli",
      "args": ["bots", "list", "--json"],
      "env": {
        "EAGLE_TOKEN": "wrong-token-0123456789-abcdefghijkl"
      },
      "expectExit": 3,
      "stderrContains": "a bearer token is required"
    },
    {
      "kind": "cli",
      "args": ["bots", "list", "--json"],
      "json": {
        "bots": [
          {
            "title": "eval cli-surface"
          }
        ]
      }
    }
  ]
}
