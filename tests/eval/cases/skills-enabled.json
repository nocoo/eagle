{
  "id": "skills-enabled",
  "title": "勾选的技能出现在提示里，Bot 用 skill_read 读到原文",
  "kind": "chat",
  "notes": "The App's ticks are the daemon's only skill input: the settings PUT stores one selected skill, the prompt carries it, a scripted model reads it with skill_read and answers from the file, and a name that was never selected is refused without losing the first result.",
  "toolGroups": ["core", "coding"],
  "model": {
    "script": [
      {
        "toolCall": {
          "name": "skill_read",
          "args": { "name": "weather-lookup" }
        }
      },
      { "text": "技能说：查天气先问城市，再报温度。" },
      {
        "toolCall": {
          "name": "skill_read",
          "args": { "name": "release-notes" }
        }
      },
      { "text": "我没有勾选 release-notes，所以读不到它。" }
    ]
  },
  "steps": [
    {
      "kind": "file",
      "path": "home/.agents/skills/weather-lookup/SKILL.md",
      "content": "---\nname: weather-lookup\ndescription: Looks up the weather.\nversion: 1.4.0\n---\n\n# Weather lookup\n\n先问城市，再报温度：eval-skill-sentence-9f2c。\n"
    },
    {
      "kind": "http",
      "method": "PUT",
      "path": "/v1/settings",
      "body": "{\"skills\":[{\"name\":\"weather-lookup\",\"version\":\"1.4.0\",\"description\":\"Looks up the weather.\",\"path\":\"~/.agents/skills/weather-lookup\"}]}",
      "expectStatus": 200
    },
    { "kind": "chat", "text": "用 weather-lookup 这个技能说说怎么查天气" },
    { "kind": "chat", "text": "那 release-notes 呢？" }
  ],
  "expect": {
    "messages": [
      { "role": "user", "contains": "weather-lookup" },
      { "role": "tool", "contains": "eval-skill-sentence-9f2c" },
      { "role": "assistant", "contains": "先问城市，再报温度" },
      { "role": "tool", "contains": "release-notes" },
      { "role": "assistant", "contains": "没有勾选" }
    ],
    "toolsCalled": ["skill_read"],
    "noErrors": true,
    "modelRequests": { "max": 6 }
  }
}
