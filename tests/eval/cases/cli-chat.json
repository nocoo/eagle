{
  "id": "cli-chat",
  "title": "通过 CLI 与 bot 对话：send --wait、history、watch、abort 后再接力",
  "kind": "chat",
  "notes": "The conversation verbs a terminal or another agent uses. The slow answer is aborted while it is still in flight, and the transcript must never carry it.",
  "timeoutMs": 120000,
  "model": {
    "script": [
      { "text": "第一答" },
      { "text": "慢答", "delayMs": 4000 },
      { "text": "第二答" }
    ]
  },
  "steps": [
    {
      "kind": "cli",
      "args": ["chat", "send", "eval cli-chat", "--text", "你好", "--wait"],
      "stdoutContains": "第一答"
    },
    {
      "kind": "cli",
      "args": ["chat", "history", "eval cli-chat", "--limit", "5"],
      "stdoutContains": "no older messages"
    },
    {
      "kind": "cli",
      "args": ["chat", "watch", "eval cli-chat"],
      "expectTimeout": true,
      "timeoutMs": 3000,
      "stdoutContains": "你好"
    },
    {
      "kind": "cli",
      "args": ["chat", "send", "eval cli-chat", "--text", "慢任务"]
    },
    { "kind": "sleep", "ms": 800 },
    {
      "kind": "cli",
      "args": ["chat", "abort", "eval cli-chat"],
      "stdoutContains": "aborted"
    },
    {
      "kind": "cli",
      "args": ["chat", "send", "eval cli-chat", "--text", "接力", "--wait"],
      "stdoutContains": "第二答"
    },
    { "kind": "sleep", "ms": 4000 }
  ],
  "expect": {
    "messages": [
      { "role": "user", "contains": "你好" },
      { "role": "assistant", "contains": "第一答" },
      { "role": "user", "contains": "慢任务" },
      { "role": "user", "contains": "接力" },
      { "role": "assistant", "contains": "第二答" }
    ],
    "messagesExcluded": [{ "role": "assistant", "contains": "慢答" }]
  }
}
