{
  "id": "cli-secret",
  "title": "Answer a password card through the CLI without exposing its value",
  "kind": "chat",
  "toolGroups": ["core", "secrets"],
  "model": {
    "script": [
      {
        "toolCall": {
          "name": "secret_request",
          "args": {
            "key": "eval-secret",
            "purpose": "Synthetic acceptance fixture",
            "scope": "bot",
            "ttlMinutes": 10
          }
        }
      },
      { "text": "The card is ready." },
      {
        "toolCall": {
          "name": "secret_read",
          "args": { "key": "eval-secret", "scope": "bot" }
        }
      },
      { "text": "The fixture record is available." }
    ]
  },
  "steps": [
    {
      "kind": "cli",
      "args": [
        "chat",
        "send",
        "eval cli-secret",
        "--text",
        "Request the synthetic fixture",
        "--wait",
        "--json"
      ],
      "stdoutContains": "secret_request",
      "oneTerminal": true,
      "capture": "reply"
    },
    {
      "kind": "cli",
      "args": [
        "chat",
        "history",
        "eval cli-secret",
        "--before",
        "{{reply.answerEntryId}}",
        "--limit",
        "20",
        "--json"
      ],
      "stdoutContains": "secret_request",
      "capture": "card"
    },
    {
      "kind": "cli",
      "args": [
        "chat",
        "secret",
        "eval cli-secret",
        "--entry",
        "{{card.messages.1.id}}",
        "--key",
        "eval-secret",
        "--stdin",
        "--json"
      ],
      "stdin": "fictional-eval-value-73d2",
      "stdoutExcludes": "fictional-eval-value-73d2"
    },
    {
      "kind": "waitFor",
      "role": "assistant",
      "contains": "The fixture record is available.",
      "count": 1
    },
    {
      "kind": "cli",
      "args": [
        "chat",
        "history",
        "eval cli-secret",
        "--before",
        "e_999999",
        "--limit",
        "100",
        "--json"
      ],
      "stdoutContains": "secret_read",
      "stdoutExcludes": "fictional-eval-value-73d2"
    }
  ],
  "expect": {
    "toolsCalled": ["secret_request", "secret_read"],
    "messagesExcluded": [{ "contains": "fictional-eval-value-73d2" }],
    "modelRequests": { "max": 4 },
    "noErrors": true
  }
}
