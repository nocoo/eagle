{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "number",
      "const": 1
    },
    "reportId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160,
      "pattern": "^[\\w.:/-]+$"
    },
    "capturedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
    },
    "machine": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80,
          "pattern": "^[a-z0-9][a-z0-9_-]*$"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "platform": {
          "type": "string",
          "maxLength": 80
        },
        "collectorVersion": {
          "type": "string",
          "maxLength": 80
        },
        "telemetry": {
          "type": "object",
          "properties": {
            "sampleIntervalSeconds": {
              "type": "number",
              "const": 30
            },
            "slowIntervalSeconds": {
              "type": "integer",
              "minimum": 60,
              "maximum": 3600
            },
            "diskObservedAt": {
              "type": "string",
              "format": "date-time",
              "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
            },
            "network": {
              "type": "object",
              "properties": {
                "state": {
                  "type": "string",
                  "enum": ["connected", "disconnected", "unknown"]
                },
                "source": {
                  "type": "string",
                  "enum": [
                    "macos-reachability",
                    "macos-vpn",
                    "network-manager",
                    "unsupported"
                  ]
                },
                "observedAt": {
                  "type": "string",
                  "format": "date-time",
                  "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
                }
              },
              "required": ["state", "source", "observedAt"],
              "additionalProperties": false
            },
            "vpn": {
              "type": "object",
              "properties": {
                "state": {
                  "type": "string",
                  "enum": ["connected", "disconnected", "unknown"]
                },
                "source": {
                  "type": "string",
                  "enum": [
                    "macos-reachability",
                    "macos-vpn",
                    "network-manager",
                    "unsupported"
                  ]
                },
                "observedAt": {
                  "type": "string",
                  "format": "date-time",
                  "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
                }
              },
              "required": ["state", "source", "observedAt"],
              "additionalProperties": false
            },
            "temperature": {
              "oneOf": [
                {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string",
                      "const": "available"
                    },
                    "celsius": {
                      "type": "number",
                      "minimum": -20,
                      "maximum": 150
                    },
                    "source": {
                      "type": "string",
                      "enum": ["linux-cpu-thermal", "macmon"]
                    },
                    "observedAt": {
                      "type": "string",
                      "format": "date-time",
                      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
                    }
                  },
                  "required": ["status", "celsius", "source", "observedAt"],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string",
                      "const": "unavailable"
                    },
                    "celsius": {
                      "type": "null"
                    },
                    "source": {
                      "type": "string",
                      "enum": ["unsupported", "linux-cpu-thermal", "macmon"]
                    },
                    "observedAt": {
                      "type": "string",
                      "format": "date-time",
                      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
                    }
                  },
                  "required": ["status", "celsius", "source", "observedAt"],
                  "additionalProperties": false
                }
              ]
            },
            "hardware": {
              "type": "object",
              "properties": {
                "observedAt": {
                  "type": "string",
                  "format": "date-time",
                  "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
                },
                "source": {
                  "type": "string",
                  "const": "macmon"
                },
                "gpuUsagePercent": {
                  "anyOf": [
                    {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 100
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "gpuTemperatureCelsius": {
                  "anyOf": [
                    {
                      "type": "number",
                      "minimum": -20,
                      "maximum": 150
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "fans": {
                  "anyOf": [
                    {
                      "maxItems": 8,
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "rpm": {
                            "type": "number",
                            "minimum": 0,
                            "maximum": 30000
                          },
                          "maxRpm": {
                            "anyOf": [
                              {
                                "type": "number",
                                "exclusiveMinimum": 0,
                                "maximum": 30000
                              },
                              {
                                "type": "null"
                              }
                            ]
                          }
                        },
                        "required": ["rpm", "maxRpm"],
                        "additionalProperties": false
                      }
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "memory": {
                  "anyOf": [
                    {
                      "type": "object",
                      "properties": {
                        "totalBytes": {
                          "type": "integer",
                          "exclusiveMinimum": 0,
                          "maximum": 9007199254740991
                        },
                        "usedBytes": {
                          "type": "integer",
                          "minimum": 0,
                          "maximum": 9007199254740991
                        }
                      },
                      "required": ["totalBytes", "usedBytes"],
                      "additionalProperties": false
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "swapUsedBytes": {
                  "anyOf": [
                    {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 9007199254740991
                    },
                    {
                      "type": "null"
                    }
                  ]
                }
              },
              "required": [
                "observedAt",
                "source",
                "gpuUsagePercent",
                "gpuTemperatureCelsius",
                "fans",
                "memory",
                "swapUsedBytes"
              ],
              "additionalProperties": false
            },
            "traffic": {
              "type": "object",
              "properties": {
                "observedAt": {
                  "type": "string",
                  "format": "date-time",
                  "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
                },
                "source": {
                  "type": "string",
                  "const": "netstat-physical"
                },
                "sampleMs": {
                  "type": "number",
                  "exclusiveMinimum": 0,
                  "maximum": 10000
                },
                "downloadBytesPerSecond": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "uploadBytesPerSecond": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 9007199254740991
                }
              },
              "required": [
                "observedAt",
                "source",
                "sampleMs",
                "downloadBytesPerSecond",
                "uploadBytesPerSecond"
              ],
              "additionalProperties": false
            },
            "observedAt": {
              "type": "string",
              "format": "date-time",
              "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
            },
            "resources": {
              "anyOf": [
                {
                  "type": "object",
                  "properties": {
                    "cpuModel": {
                      "type": "string",
                      "maxLength": 240
                    },
                    "cpuCores": {
                      "type": "integer",
                      "exclusiveMinimum": 0,
                      "maximum": 4096
                    },
                    "cpuUsagePercent": {
                      "anyOf": [
                        {
                          "type": "number",
                          "minimum": 0,
                          "maximum": 100
                        },
                        {
                          "type": "null"
                        }
                      ]
                    },
                    "cpuSampleMs": {
                      "type": "number",
                      "exclusiveMinimum": 0
                    },
                    "loadAverage": {
                      "anyOf": [
                        {
                          "type": "array",
                          "prefixItems": [
                            {
                              "type": "number",
                              "minimum": 0
                            },
                            {
                              "type": "number",
                              "minimum": 0
                            },
                            {
                              "type": "number",
                              "minimum": 0
                            }
                          ],
                          "items": false,
                          "minItems": 3,
                          "maxItems": 3
                        },
                        {
                          "type": "null"
                        }
                      ]
                    },
                    "memory": {
                      "type": "object",
                      "properties": {
                        "totalBytes": {
                          "type": "integer",
                          "exclusiveMinimum": 0,
                          "maximum": 9007199254740991
                        },
                        "freeBytes": {
                          "type": "integer",
                          "minimum": 0,
                          "maximum": 9007199254740991
                        }
                      },
                      "required": ["totalBytes", "freeBytes"],
                      "additionalProperties": false
                    },
                    "disk": {
                      "anyOf": [
                        {
                          "type": "object",
                          "properties": {
                            "totalBytes": {
                              "type": "integer",
                              "exclusiveMinimum": 0,
                              "maximum": 9007199254740991
                            },
                            "availableBytes": {
                              "type": "integer",
                              "minimum": 0,
                              "maximum": 9007199254740991
                            }
                          },
                          "required": ["totalBytes", "availableBytes"],
                          "additionalProperties": false
                        },
                        {
                          "type": "null"
                        }
                      ]
                    },
                    "uptimeSeconds": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 9007199254740991
                    }
                  },
                  "required": [
                    "cpuModel",
                    "cpuCores",
                    "cpuUsagePercent",
                    "cpuSampleMs",
                    "loadAverage",
                    "memory",
                    "disk",
                    "uptimeSeconds"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "null"
                }
              ]
            },
            "ports": {
              "maxItems": 32,
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 80
                  },
                  "host": {
                    "default": "127.0.0.1",
                    "type": "string",
                    "enum": ["127.0.0.1", "::1"]
                  },
                  "port": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 65535
                  },
                  "status": {
                    "type": "string",
                    "enum": ["open", "closed", "timeout", "error"]
                  },
                  "latencyMs": {
                    "anyOf": [
                      {
                        "type": "number",
                        "minimum": 0
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "checkedAt": {
                    "type": "string",
                    "format": "date-time",
                    "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
                  }
                },
                "required": [
                  "name",
                  "port",
                  "status",
                  "latencyMs",
                  "checkedAt"
                ],
                "additionalProperties": false
              }
            }
          },
          "required": ["observedAt", "resources", "ports"],
          "additionalProperties": false
        }
      },
      "required": ["id", "name", "platform", "collectorVersion"],
      "additionalProperties": false
    },
    "spaces": {
      "maxItems": 200,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "availability": {
            "type": "string",
            "const": "unavailable"
          },
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160,
            "pattern": "^[\\w.:/-]+$"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 240
          },
          "session": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "objective": {
            "type": "string",
            "maxLength": 1000
          },
          "tabs": {
            "maxItems": 50,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 160,
                  "pattern": "^[\\w.:/-]+$"
                },
                "name": {
                  "type": "string",
                  "maxLength": 240
                },
                "panes": {
                  "maxItems": 100,
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "id": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 160,
                        "pattern": "^[\\w.:/-]+$"
                      },
                      "title": {
                        "type": "string",
                        "maxLength": 240
                      },
                      "agent": {
                        "type": "string",
                        "maxLength": 80
                      },
                      "hint": {
                        "type": "string",
                        "enum": [
                          "working",
                          "idle",
                          "done",
                          "blocked",
                          "unknown"
                        ]
                      },
                      "task": {
                        "type": "object",
                        "properties": {
                          "id": {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 160,
                            "pattern": "^[\\w.:/-]+$"
                          },
                          "title": {
                            "type": "string",
                            "maxLength": 500
                          },
                          "requiresDeployment": {
                            "type": "boolean"
                          }
                        },
                        "required": ["id", "title", "requiresDeployment"],
                        "additionalProperties": false
                      },
                      "rect": {
                        "type": "object",
                        "properties": {
                          "x": {
                            "type": "number",
                            "minimum": 0,
                            "maximum": 1
                          },
                          "y": {
                            "type": "number",
                            "minimum": 0,
                            "maximum": 1
                          },
                          "width": {
                            "type": "number",
                            "exclusiveMinimum": 0,
                            "maximum": 1
                          },
                          "height": {
                            "type": "number",
                            "exclusiveMinimum": 0,
                            "maximum": 1
                          }
                        },
                        "required": ["x", "y", "width", "height"],
                        "additionalProperties": false
                      },
                      "evidence": {
                        "maxItems": 30,
                        "type": "array",
                        "items": {
                          "type": "object",
                          "properties": {
                            "kind": {
                              "type": "string",
                              "enum": [
                                "summary",
                                "goal",
                                "git",
                                "test",
                                "process",
                                "deployment"
                              ]
                            },
                            "status": {
                              "type": "string",
                              "enum": [
                                "success",
                                "failure",
                                "running",
                                "waiting",
                                "unknown"
                              ]
                            },
                            "summary": {
                              "type": "string",
                              "maxLength": 2000
                            },
                            "source": {
                              "type": "string",
                              "minLength": 1,
                              "maxLength": 240
                            },
                            "observedAt": {
                              "type": "string",
                              "format": "date-time",
                              "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
                            },
                            "taskId": {
                              "type": "string",
                              "minLength": 1,
                              "maxLength": 160,
                              "pattern": "^[\\w.:/-]+$"
                            },
                            "revision": {
                              "type": "string",
                              "maxLength": 100
                            }
                          },
                          "required": [
                            "kind",
                            "status",
                            "summary",
                            "source",
                            "observedAt",
                            "taskId"
                          ],
                          "additionalProperties": false
                        }
                      }
                    },
                    "required": [
                      "id",
                      "title",
                      "agent",
                      "hint",
                      "task",
                      "rect",
                      "evidence"
                    ],
                    "additionalProperties": false
                  }
                }
              },
              "required": ["id", "name", "panes"],
              "additionalProperties": false
            }
          }
        },
        "required": ["id", "name", "session", "objective", "tabs"],
        "additionalProperties": false
      }
    },
    "warnings": {
      "maxItems": 100,
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 500
      }
    }
  },
  "required": [
    "schemaVersion",
    "reportId",
    "capturedAt",
    "machine",
    "spaces",
    "warnings"
  ],
  "additionalProperties": false
}
