{
  "name": "@nocoo/bots-daemon",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Local multi-bot chat daemon backed by pi-durable",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "start": "node --experimental-strip-types --env-file-if-exists=.env scripts/serve.ts",
    "test": "sh scripts/run-tests.sh",
    "test:runtime": "sh scripts/run-suite.sh test/runtime",
    "test:protocol": "sh scripts/run-suite.sh test/protocol",
    "golden:record": "node --experimental-strip-types scripts/record-golden.ts --write",
    "test:crash": "sh scripts/run-suite.sh test/crash",
    "perf": "sh scripts/run-suite.sh test/perf",
    "typecheck": "tsc --noEmit",
    "lint": "biome check --error-on-warnings .",
    "format": "biome check --write .",
    "coverage": "sh scripts/run-tests.sh --coverage",
    "fixtures:check": "node --experimental-strip-types scripts/fixtures.ts check",
    "fixtures:write": "node --experimental-strip-types scripts/fixtures.ts write",
    "smoke:model": "node --env-file-if-exists=.env --experimental-strip-types scripts/smoke-model.ts",
    "check": "npm run fixtures:check && npm test && npm run typecheck && npm run lint && npm run coverage",
    "eval": "node --experimental-strip-types scripts/eval.ts",
    "eval:cli": "sh scripts/eval-cli.sh"
  },
  "dependencies": {
    "@earendil-works/chord": "1.4.0",
    "@earendil-works/pi-ai": "1.4.0",
    "@earendil-works/pi-durable": "1.4.0",
    "croner": "11.0.0",
    "ws": "8.22.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@babel/parser": "^7.29.0",
    "@biomejs/biome": "^2.6.4",
    "@types/node": "26.6.5",
    "@types/ws": "8.18.1",
    "typescript": "7.0.2"
  }
}
